local function WeldAllTo(Part1, Part2, scan, Extra)
	local EXCF = Part2.CFrame * Extra
	for _, v3 in ipairs(scan:GetDescendants()) do
		if v3:IsA("BasePart") then
			local STW = weld(v3, v3, Part1, EXCF:toObjectSpace(v3.CFrame):inverse())
			v3.Anchored = false
			v3.Massless = true
			v3.CanCollide = false
			v3.Parent = Part1
			v3.Locked = true
		end
	end
	Part1.Transparency = 1
end

