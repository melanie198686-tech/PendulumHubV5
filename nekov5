local non = workspace:FindFirstChild("non")
if not non then
	warn("[Neko] workspace.non missing! Creating a fallback dummy rig...")
	
	local function buildDummy()
		local model = Instance.new("Model")
		model.Name = "non"
		
		local parts = {"HumanoidRootPart", "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}
		for _, pName in ipairs(parts) do
			local p = Instance.new("Part", model)
			p.Name = pName
			p.Size = (pName == "HumanoidRootPart" or pName == "Torso") and Vector3.new(2,2,1) or Vector3.new(1,2,1)
			if pName == "Head" then p.Size = Vector3.new(2,1,1) end
			p.Transparency = 1
			p.CanCollide = false
			p.Anchored = false
			p.Massless = true
		end
		
		local humanoid = Instance.new("Humanoid", model)
		humanoid.RigType = Enum.HumanoidRigType.R6
		
		model.PrimaryPart = model.HumanoidRootPart
		if Character and Character:FindFirstChild("HumanoidRootPart") then
			model:PivotTo(Character.HumanoidRootPart.CFrame)
		end
		
		-- Weld them together
		local function w(p0, p1, c0)
			local w = Instance.new("Weld", p0)
			w.Part0, w.Part1, w.C0 = p0, p1, c0
		end
		w(model.HumanoidRootPart, model.Torso, CFrame.new(0,0,0))
		w(model.Torso, model.Head, CFrame.new(0,1.5,0))
		w(model.Torso, model["Left Arm"], CFrame.new(-1.5,0.5,0))
		w(model.Torso, model["Right Arm"], CFrame.new(1.5,0.5,0))
		w(model.Torso, model["Left Leg"], CFrame.new(-0.5,-1.5,0))
		w(model.Torso, model["Right Leg"], CFrame.new(0.5,-1.5,0))
		
		return model
	end

	local success, cloned = pcall(function()
		local char = Player.Character
		if not char then return nil end
		char.Archivable = true
		for _, v in ipairs(char:GetDescendants()) do v.Archivable = true end
		local c = char:Clone()
		c.Name = "non"
		for _, v in ipairs(c:GetDescendants()) do
			if v:IsA("BasePart") then v.Transparency = 1; v.CanCollide = false end
			if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end
		end
		return c
	end)

	if success and cloned then
		cloned.Parent = workspace
		non = cloned
	else
		warn("[Neko] Clone failed. Creating manual invisible rig...")
		non = buildDummy()
		non.Parent = workspace
	end
end

