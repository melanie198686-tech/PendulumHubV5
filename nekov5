local function GatherAllInstances(Parent, ig)
	local Instances = {}
	local function rec(p, ignore)
		for _, v in ipairs(p:GetChildren()) do
			if v ~= ignore then
				rec(v, ignore)
				table.insert(Instances, v)
			end
		end
	end
	rec(Parent, ig)
	return Instances
end

