						local RH2 = cf(-forWRL/9*math.cos(sine/8),0,forWFB/7*math.cos(sine/8))*angles(math.rad(-forWFB*60)*math.cos(sine/8),0,math.rad(-forWRL*25)*math.cos(sine/8))
						local LH2 = cf(forWRL/9*math.cos(sine/8),0,-forWFB/7*math.cos(sine/8))*angles(math.rad(forWFB*60)*math.cos(sine/8),0,math.rad(forWRL*25)*math.cos(sine/8))
						SetTween(RJW,{C0=RootCF*CFrame.new(0,0,-0.05-0.1*math.cos(sine/4)-math.sin(sine/4)/8)*angles(math.rad(forWFB*25-(-forWFB)),0,math.rad(8*math.cos(sine/8)))},"Quad","InOut",WalkAnimMove/speed)
						SetTween(NeckW,{C0=NeckCF*CFrame.new(0,0,0.025*math.cos(sine/4))*angles(0,math.rad((forWRL*2-forWRL*math.cos(sine/4))*3.5),math.rad(-forWRL*45+-8*math.cos(sine/8)))},"Quad","InOut",WalkAnimMove/speed)
						SetTween(RW,{C0=cf(1.5,0.5+0.05*math.cos(sine/8),0)*angles(math.rad(forWFB*-65-(-forWFB)),math.rad(-5),math.rad(6-6*math.cos(sine/8)))},"Quad","Out",0.2)
						SetTween(LW,{C0=cf(-1.45,0.5+0.05*math.cos(sine/8),0)*angles(math.rad(forWFB*-65-(-forWFB)),math.rad(5),math.rad(-6+6*math.cos(sine/8)))},"Quad","Out",0.2)
						SetTween(RH,{C0=CFrame.new(.5,-0.95+0.25*math.sin(sine/8),-.1+.25*math.cos(sine/8))*RH2*CFrame.Angles(0,0,0)},"Quad","InOut",WalkAnimMove/speed)
						SetTween(LH,{C0=CFrame.new(-.5,-0.95-0.25*math.sin(sine/8),-.1-.25*math.cos(sine/8))*LH2*CFrame.Angles(0,0,0)},"Quad","InOut",WalkAnimMove/speed)
					end
				elseif Anim == "Sit" then
					SetTween(RJW,{C0=RootCF*CFrame.new(0,0,0)},"Quad","InOut",0.1)
					SetTween(NeckW,{C0=NeckCF*CFrame.new(0,0,0)},"Quad","InOut",0.1)
					SetTween(RW,{C0=CFrame.new(1.5,0.5,0)},"Quad","Out",0.1)
					SetTween(LW,{C0=CFrame.new(-1.5,0.5,0)},"Quad","Out",0.1)
					SetTween(RH,{C0=CFrame.new(.5,-1,0)*angles(math.rad(90),0,0)},"Quad","InOut",0.1)
					SetTween(LH,{C0=CFrame.new(-.5,-1,0)*angles(math.rad(90),0,0)},"Quad","InOut",0.1)
				end
			end

			if attack == false and not (agresive == true and Anim == "Walk") then
				tailSafe(tailc0)
			end
		end)
		if not success then
			warn("[Neko] Loop error:", err)
		end
		Swait(Animstep*30)
	end
end

