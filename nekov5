local function CreatePart(Parent, Material, Reflectance, Transparency, BColor, Name, Size)
	local Part = Create("Part")({
		Parent = Parent, Reflectance = Reflectance, Transparency = Transparency,
		CanCollide = false, Locked = true,
		BrickColor = BrickColor.new(tostring(BColor)), Name = Name,
		Size = Size, Material = Material,
	})
	RemoveOutlines(Part)
	return Part
end

local function CreatePart2(FORMFACTOR, PARENT, MATERIAL, REFLECTANCE, TRANSPARENCY, BRICKCOLOR, NAME, SIZE, ANCHOR)
	local P = IT("Part")
	P.Reflectance = REFLECTANCE
	P.Transparency = TRANSPARENCY
	P.CanCollide = false
	P.Locked = true
	P.Anchored = ANCHOR ~= false
	P.BrickColor = BRICKC(tostring(BRICKCOLOR))
	P.Name = NAME
	P.Size = SIZE
	P.Position = Torso.Position
	P.Material = MATERIAL
	P:BreakJoints()
	P.Parent = PARENT
	return P
end

local function CreateMesh2(MESH, PARENT, MESHTYPE, MESHID, TEXTUREID, SCALE, OFFSET)
	local M = IT(MESH)
	if MESH == "SpecialMesh" then
		M.MeshType = MESHTYPE
		if MESHID ~= "nil" and MESHID ~= "" then M.MeshId = "http://www.roblox.com/asset/?id="..MESHID end
		if TEXTUREID ~= "nil" and TEXTUREID ~= "" then M.TextureId = "http://www.roblox.com/asset/?id="..TEXTUREID end
	end
	M.Offset = OFFSET or VT(0,0,0)
	M.Scale = SCALE
	M.Parent = PARENT
	return M
end

local function CreateSound2(ID, PARENT, VOLUME, PITCH, DOESLOOP)
	local snd = it("Sound")
	snd.Parent = PARENT
	snd.Volume = VOLUME
	snd.Pitch = PITCH
	snd.SoundId = "http://www.roblox.com/asset/?id="..ID
	snd:Play()
	if DOESLOOP then snd.Looped = true
	else
		task.spawn(function() repeat task.wait(1) until not snd.Playing; snd:Destroy() end)
	end
	return snd
end

local function WACKYEFFECT(T)
	local TYPE     = T.EffectType or "Sphere"
	local SIZE     = T.Size or VT(1,1,1)
	local ENDSIZE  = T.Size2 or VT(0,0,0)
	local TRANS    = T.Transparency or 0
	local ENDTRANS = T.Transparency2 or 1
	local CFRAME   = T.CFrame or Torso.CFrame
	local MOVEDIR  = T.MoveToPos
	local ROT1,ROT2,ROT3 = T.RotationX or 0, T.RotationY or 0, T.RotationZ or 0
	local MAT      = T.Material or "Neon"
	local COLOR    = T.Color or C3(1,1,1)
	local TIME     = T.Time or 45
	local SID, SPITCH, SVOL = T.SoundID, T.SoundPitch, T.SoundVolume
	local snd = nil
	if SID and SPITCH and SVOL then snd = CreateSound2(SID, Effects, SVOL, SPITCH, false) end
	local EFFECT = CreatePart2(3, Effects, MAT, 0, TRANS, BRICKC("Pearl"), "Effect", VT(1,1,1), true)
	EFFECT.Color = COLOR
	local MSH
	if TYPE == "Sphere"   then MSH = CreateMesh2("SpecialMesh", EFFECT, "Sphere", "", "", SIZE, VT())
	elseif TYPE == "Cylinder" then MSH = CreateMesh2("SpecialMesh", EFFECT, "Cylinder", "", "", SIZE, VT())
	elseif TYPE == "Block" then MSH = IT("BlockMesh", EFFECT); MSH.Scale = VT(SIZE.X,SIZE.X,SIZE.X)
	elseif TYPE == "Cube"  then MSH = IT("BlockMesh", EFFECT); MSH.Scale = VT(SIZE.X,SIZE.X,SIZE.X)
	elseif TYPE == "Wave"  then MSH = CreateMesh2("SpecialMesh", EFFECT, "FileMesh", "20329976", "", SIZE, VT(0,0,-SIZE.X/8))
	elseif TYPE == "Ring"  then MSH = CreateMesh2("SpecialMesh", EFFECT, "FileMesh", "559831844", "", VT(SIZE.X,SIZE.X,0.1), VT())
	elseif TYPE == "Slash" then MSH = CreateMesh2("SpecialMesh", EFFECT, "FileMesh", "662586858", "", VT(SIZE.X/10,0,SIZE.X/10), VT())
	elseif TYPE == "Round Slash" then MSH = CreateMesh2("SpecialMesh", EFFECT, "FileMesh", "662585058", "", VT(SIZE.X/10,0,SIZE.X/10), VT())
	elseif TYPE == "Swirl" then MSH = CreateMesh2("SpecialMesh", EFFECT, "FileMesh", "1051557", "", SIZE, VT())
	elseif TYPE == "Skull" then MSH = CreateMesh2("SpecialMesh", EFFECT, "FileMesh", "4770583", "", SIZE, VT())
	elseif TYPE == "Crystal" then MSH = CreateMesh2("SpecialMesh", EFFECT, "FileMesh", "9756362", "", SIZE, VT())
	elseif TYPE == "Crown" then MSH = CreateMesh2("SpecialMesh", EFFECT, "FileMesh", "173770780", "", SIZE, VT())
	end
	if not MSH then EFFECT:Destroy(); return end
	EFFECT.CFrame = CFRAME
	SetTween(EFFECT, {Transparency = ENDTRANS}, "Quad", "InOut", TIME/60)
	SetTween(MSH, {Scale = ENDSIZE}, "Quad", "InOut", TIME/60)
	if MOVEDIR then
		SetTween(EFFECT, {CFrame = CF(MOVEDIR)}, "Quad", "InOut", TIME/60)
	end
	Debris:AddItem(EFFECT, 15)
	if snd then snd.Stopped:Connect(function() if EFFECT then EFFECT:Destroy() end end)
	else EFFECT:Destroy() end
end

local ShowDamage
ShowDamage = function(Pos, Text, Time, Color)
	local Rate = 0.033333333333333
	Pos = Pos or Vector3.new(0,0,0)
	Text = Text or ""
	Time = Time or 2
	Color = Color or Color3.new(1, 0.545098, 0.552941)

	local EffectPart = CreatePart(workspace, "SmoothPlastic", 0, 1, BrickColor.new(Color), "Effect", Vector3.new(0,0,0))
	EffectPart.Anchored = true
	local BBG = Create("BillboardGui")({Size = UDim2.new(2,0,2,0), Adornee = EffectPart, Parent = EffectPart})
	local Txt = Create("TextLabel")({
		BackgroundTransparency = 1, Size = UDim2.new(1,0,1,0), Text = tostring(Text),
		TextColor3 = Color, TextScaled = true, Font = Enum.Font.SourceSansBold, Parent = BBG
	})
	Txt.TextTransparency = 1
	Debris:AddItem(EffectPart, Time + 0.1)
	EffectPart.Parent = workspace

	task.spawn(function()
		local Frames = Time / Rate
		EffectPart.CFrame = CFrame.new(Pos)
		task.wait()
		Txt.TextTransparency = 0
		SetTween(Txt, {TextTransparency = 1}, "Quad", "In", Frames/60)
		SetTween(Txt, {Rotation = math.random(-25,25)}, "Elastic", "InOut", Frames/60)
		SetTween(Txt, {TextColor3 = Color3.new(1,0,0)}, "Elastic", "InOut", Frames/60)

		local offset = Vector3.new(math.random(-5,5), math.random(1,5), math.random(-5,5))
		SetTween(EffectPart, {CFrame = CFrame.new(Pos + offset)}, "Quad", "InOut", Frames/60)

		task.wait(Frames/60)
		if EffectPart and EffectPart.Parent then EffectPart:Destroy() end
	end)
end

local function Damagefunc(Part, hit, minim, maxim, knockback, Type, Property, Delay, HitSound, HitPitch)
	if hit.Parent == nil then return end
	local h = hit.Parent:FindFirstChildOfClass("Humanoid")
	if not h then return end
	if h.Health < 0.001 then return end
	if hit.Parent:FindFirstChild("Fly away") then return end
	if hit.Parent:FindFirstChild("DebounceHit") and hit.Parent.DebounceHit.Value then return end

	local c = Create("ObjectValue")({Name = "creator", Value = Player, Parent = h})
	Debris:AddItem(c, 0.5)

	if HitSound and HitPitch then so(HitSound, hit, 1, HitPitch) end

	local Damage = math.random(minim, maxim)
	local blocked = false
	local block = hit.Parent:FindFirstChild("Block")
	if block and block.ClassName == "IntValue" and block.Value > 0 then
		blocked = true
		block.Value = block.Value - 1
	end
	local amount = blocked and (Damage/2) or Damage
	ShowDamage(Part.CFrame * CFrame.new(0, 0, Part.Size.Z/2).p + Vector3.new(0, 1.5, 0), -amount, 1.5, Color3.new(0,0,0))

	local debounce = Create("BoolValue")({Name = "DebounceHit", Parent = hit.Parent, Value = true})
	Debris:AddItem(debounce, Delay or 0.1)
end

local function MagniDamage(Part, magni, mindam, maxdam, knock, Type2)
	local Type = mememode and "Instakill" or Type2
	if Type2 == "NormalKnockdown" then Type = "Knockdown" end
	for _, c in ipairs(workspace:GetChildren()) do
		local hum = c:FindFirstChild("Humanoid")
		if hum then
			local head = c:FindFirstChild("Head")
			if head and c.Name ~= Player.Name then
				if (head.Position - Part.Position).Magnitude <= magni then
					Damagefunc(Part, head, mindam, maxdam, knock, Type, RootPart, 0.1, "851453784", 1.2)
				end
			end
		end
	end
end

