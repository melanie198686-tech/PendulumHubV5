local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- =====================================================================
-- THE GREY SPINNING PART + TELEPORT LOGIC
-- =====================================================================

local SPIN_SPEED = 25
local CLICK_RANGE = 25
local HOLD_DURATION = 1
local GREY_PART_NAME = "LunyxSpinner"

local isActive = false
local currentAngle = 0

local function getRoot()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getTorso()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
end

local function removeAllSpinners()
    local char = LocalPlayer.Character
    if char then
        for _, obj in ipairs(char:GetDescendants()) do
            if obj.Name == GREY_PART_NAME then obj:Destroy() end
        end
    end
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name == GREY_PART_NAME then obj:Destroy() end
    end
end

-- Skips the spinner so it stays visible while your body goes invisible
local function setCharacterVisibility(visible)
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part.Name == GREY_PART_NAME then continue end
        if part:IsA("BasePart") or part:IsA("Decal") then
            part.Transparency = visible and 0 or 1
        end
    end
end

local function createSpinner()
    local char = LocalPlayer.Character
    local torso = getTorso()
    if not char or not torso then return end

    removeAllSpinners()

    local part = Instance.new("Part")
    part.Name = GREY_PART_NAME
    part.Size = torso.Size
    part.Color = Color3.fromRGB(163, 162, 165) -- Normal Grey
    part.Material = Enum.Material.SmoothPlastic
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.Massless = true
    part.CFrame = torso.CFrame
    part.Parent = char

    RunService.RenderStepped:Connect(function(dt)
        if not part or not part.Parent then return end
        local t = getTorso()
        if not t then return end
        
        currentAngle = currentAngle + (SPIN_SPEED * dt)
        part.CFrame = t.CFrame * CFrame.Angles(currentAngle, 0, currentAngle)
    end)
end

local function findNearestPlayer()
    local myRoot = getRoot()
    if not myRoot then return nil end

    local myPos = myRoot.Position
    local nearest = nil
    local nearestDist = CLICK_RANGE

    for _, other in ipairs(Players:GetPlayers()) do
        if other == LocalPlayer then continue end
        local otherChar = other.Character
        if not otherChar then continue end
        local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
        if not otherRoot then continue end
        local otherHum = otherChar:FindFirstChildOfClass("Humanoid")
        if otherHum and otherHum.Health <= 0 then continue end

        local dist = (otherRoot.Position - myPos).Magnitude
        if dist <= nearestDist then
            nearestDist = dist
            nearest = otherRoot
        end
    end

    return nearest
end

local function executeTeleport(targetRoot)
    if isActive then return end
    local myChar = LocalPlayer.Character
    local myRoot = getRoot()
    if not myChar or not myRoot or not targetRoot then return end

    isActive = true

    local savedCFrame = myRoot.CFrame
    local savedCameraCFrame = camera.CFrame
    local savedCameraType = camera.CameraType

    -- Lock camera at current position
    camera.CameraType = Enum.CameraType.Scriptable
    camera.CFrame = savedCameraCFrame

    -- Turn invisible
    setCharacterVisibility(false)

    myRoot.CFrame = targetRoot.CFrame

    local followConn
    followConn = RunService.RenderStepped:Connect(function()
        if not myRoot.Parent or not targetRoot.Parent then return end
        myRoot.CFrame = targetRoot.CFrame
        
        -- Force invisibility
        for _, part in ipairs(myChar:GetDescendants()) do
            if part.Name == GREY_PART_NAME then continue end
            if part:IsA("BasePart") or part:IsA("Decal") then
                part.Transparency = 1
            end
        end
    end)

    task.wait(HOLD_DURATION)

    if followConn then followConn:Disconnect() end

    -- Teleport back
    if myRoot and myRoot.Parent then
        myRoot.CFrame = savedCFrame
    end

    -- Turn visible
    setCharacterVisibility(true)

    -- Restore camera
    camera.CameraType = savedCameraType
    camera.CFrame = savedCameraCFrame

    isActive = false
end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    if isActive then return end

    local targetRoot = findNearestPlayer()
    if targetRoot then
        executeTeleport(targetRoot)
    end
end)

local hasSpawned = false
LocalPlayer.CharacterAdded:Connect(function(char)
    removeAllSpinners() 
    if not hasSpawned then
        hasSpawned = true
        task.wait(0.5)
        createSpinner()
    end
end)

if LocalPlayer.Character then
    if not hasSpawned then
        hasSpawned = true
        task.wait(0.5)
        createSpinner()
    end
end
